{
  "name": "erp-fiscal-tcc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node server/migrate.js",
    "admin:create": "node scripts/admin.mjs",
    "platform:grant": "node scripts/platform-admin.mjs",
    "dev": "concurrently -k -n API,WEB \"node --watch server/index.js\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js",
    "test:db": "node scripts/test-db.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:workflow": "node scripts/test-workflow-ui.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.2.2"
  }
}
